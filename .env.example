# Database (Neon PostgreSQL connection string)
DATABASE_URL=postgresql://user:password@ep-example.region.aws.neon.tech/srimurugan?sslmode=require

# Admin Authentication
ADMIN_PASSWORD=your_secure_admin_password
SESSION_SECRET=your_32_char_random_session_secret

# Razorpay Payments
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...

# Cloudflare R2 Object Storage (Optional - falls back to local /uploads/ if omitted)
# Cloudflare Dashboard -> R2 -> Overview -> Account details -> Account ID
R2_ACCOUNT_ID=
# Cloudflare Dashboard -> R2 -> Manage R2 API Tokens -> Create API Token
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Your Cloudflare R2 bucket name
R2_BUCKET_NAME=srimurugan-media
# Public access domain or custom domain (e.g. https://pub-xxx.r2.dev or https://media.yourdomain.com)
R2_PUBLIC_DOMAIN=

